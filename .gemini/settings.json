{
  "mcpServers": {
    "p2p-supply-chain-agent": {
      "command": "java",
      "args": [
        "-Dspring.profiles.active=mcp-stdio",
        "-Dspring.main.banner-mode=off",
        "-Dlogging.pattern.console=",
        "-Xmx512m",
        "-jar",
        "target/p2p-supply-chain-agent-0.0.1-SNAPSHOT.jar"
      ],
      "env": {
        "SPRING_PROFILES_ACTIVE": "mcp-stdio"
      },
      "timeout": 30000,
      "trust": true
    }
  }
}