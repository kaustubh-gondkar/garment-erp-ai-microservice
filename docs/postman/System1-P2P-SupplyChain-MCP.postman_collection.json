                  "pm.test(\"Status is COMPLETED or AWAITING_HUMAN_APPROVAL\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect([\"COMPLETED\", \"AWAITING_HUMAN_APPROVAL\", \"TERMINATED_STEP_LIMIT\"]).to.include(json.status);\r\n});\r\n\r\npm.test(\"Step count obeys bounds\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.stepsUsed).to.be.at.most(6);\r\n});"
